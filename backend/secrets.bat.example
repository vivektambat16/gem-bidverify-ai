@echo off
rem Copy this file to "secrets.bat" (same folder) and fill in your own values.
rem Never share secrets.bat, never submit it, never upload it anywhere.

rem --- Send the login OTP by e-mail (Gmail example) ---
rem Needs a Google "App password" (Google Account > Security > 2-Step Verification > App passwords).
set GEM_SMTP_HOST=smtp.gmail.com
set GEM_SMTP_PORT=587
set GEM_SMTP_USER=your.address@gmail.com
set GEM_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
set GEM_SMTP_FROM=your.address@gmail.com

rem --- E-mail given to the demo officer account the FIRST time the database is created ---
rem set GEM_DEMO_OFFICER_EMAIL=your.address@gmail.com
